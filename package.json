{
  "name": "claude-rag-assistant",
  "version": "0.2.0",
  "description": "Small, self-hosted support assistant: your documents in, grounded answers out. Local embeddings, Claude for the answer, one script to ingest, one file to embed on any site.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "ingest": "node src/ingest.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "rag",
    "claude",
    "anthropic",
    "chatbot",
    "support",
    "embeddings",
    "express"
  ],
  "author": "Amir Šujić",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^18.0.9",
    "express": "^5.3.0"
  }
}